# Replicate AI video generation. Get a token at https://replicate.com/account/api-tokens
# When set, generate_property_video uses AI instead of the FFmpeg slideshow.
REPLICATE_API_TOKEN=
# Optional: override the AI video model. Defaults to kwaivgi/kling-v1.6-standard (~$0.05/clip).
# Alternatives:
#   minimax/video-01                          (premium, ~$0.50/clip, smoother motion)
#   stability-ai/stable-video-diffusion       (cheap fallback)
# Format: "owner/name" (uses latest version) or "owner/name:versionhash"
REPLICATE_VIDEO_MODEL=
# Optional: path to a local MP3/M4A. If set, mixed into every generated video
# at 35% volume, looped to fit the clip duration. Use a royalty-free track.
# Example: BACKGROUND_MUSIC_PATH=C:/Users/.../Music/property-bg.mp3
